{
  "expo": {
    "name": "Gopher Forge",
    "slug": "gopher-forge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#080A09"
    },
    "userInterfaceStyle": "dark",
    "scheme": "gopher-forge",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tobigrant.gopherforge"
    },
    "android": {
      "package": "com.tobigrant.gopherforge",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080A09"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "6ab5ff65-6935-4bc2-98ef-6e892e3ccae0"
      }
    },
    "owner": "tobi.js"
  }
}
